# Normalize text; let Git detect binary content for unspecified formats.
* text=auto

# Shared source and Unity YAML files remain ordinary Git text.
*.cs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.compute text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Editable art and audio: Git LFS, including upper-case file extensions.
*.[pP][sS][dD] filter=lfs diff=lfs merge=lfs -text
*.[pP][sS][bB] filter=lfs diff=lfs merge=lfs -text
*.[aA][sS][eE][pP][rR][iI][tT][eE] filter=lfs diff=lfs merge=lfs -text
*.[aA][sS][eE] filter=lfs diff=lfs merge=lfs -text
*.[kK][rR][aA] filter=lfs diff=lfs merge=lfs -text
*.[wW][aA][vV] filter=lfs diff=lfs merge=lfs -text
*.[aA][iI][fF] filter=lfs diff=lfs merge=lfs -text
*.[aA][iI][fF][fF] filter=lfs diff=lfs merge=lfs -text
*.[fF][lL][aA][cC] filter=lfs diff=lfs merge=lfs -text
*.[oO][gG][gG] filter=lfs diff=lfs merge=lfs -text
*.[mM][pP]3 filter=lfs diff=lfs merge=lfs -text

# Small PNG exports use normal Git. Add specific large binaries before their first commit.
# Do not put scenes, prefabs, scripts or .meta files into LFS.
