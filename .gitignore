# Unity project root: commit Assets, Packages and ProjectSettings, including .meta files.
# Based on the categories in github/gitignore's Unity template.

# Generated Unity data and local output
/.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Bb]uild/
/[Bb]uilds/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/tmp/
*.log

# Local IDE data and generated C# project files
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# Only these generated metadata types; do not ignore general *.meta files.
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Local/crash files
sysinfo.txt
mono_crash.*
*.tmp
*.bak
.DS_Store
Thumbs.db
Desktop.ini

# Local packaging and tool output
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
*.blend1
*.blend1.meta
crashlytics-build.properties
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/UIElementsSchema/
/[Aa]ssets/[Ss]ceneDependencyCache*

# Addressables generated content, if the package is introduced later
/ServerData/
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/Addressables_Temp*

# Local secrets, if any tools require them
.env
.env.*
!.env.example
