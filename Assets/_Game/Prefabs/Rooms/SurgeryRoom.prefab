  m_Script: {fileID: 11500000, guid: 0b884e95bf60f257ba8b624d98dd0bb2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteItem
  journalEntry: {fileID: 11400000, guid: 754b364ba280c42478dacae37c398f6d, type: 2}
  noteTitle: Jamie's Letter
  noteBody: "Happy birthday Alife!\n\nTo my travel partner and the closest friend.
    You've been here for the good and bad times and I hope these bad ones will be
    over soon. I miss our travels and I hope we can go to that Machu Picchu trip
    soon! \n\nAnyways remember to stay true to yourself and your dreams! Life\u2019s
    too short not to pursue your dreams!! \n\nAll the best, Jamie "
  noteImage: {fileID: 0}
  noteImageWidth: 0
  noteImageHeight: 0
  onFinishedReading:
    m_PersistentCalls:
      m_Calls: []
