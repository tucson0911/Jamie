  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteItem
  noteTitle: Patient's Files
  noteBody: "You open the sealed file and read the patient's name. \n\nJamie Hill\nAged
    32\nDiagnose: Lymphoma\nStage 3\n\nDays spent in St Mary Hospital: 72\n\nNumber
    of Experiments executed: 5\n\nSuccessful treatments: 0\n\nCurrent State: Heavy
    breathing, difficulty walking, appearance significantly altered, having hallucinations
    due to the heavy medication, appetite increased \n\nNext Test: Hemostatil Dosage
    (50 ml) "
  noteImage: {fileID: 0}
  noteImageWidth: 0
  noteImageHeight: 0
  onFinishedReading:
    m_PersistentCalls:
      m_Calls: []
