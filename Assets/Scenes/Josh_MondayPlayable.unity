  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0b884e95bf60f257ba8b624d98dd0bb2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteItem
  noteTitle: Birthday Card
  noteBody: "Dear Alfie,\r\n\r\nI wish you the happiest birthday!  Can believe we\u2019re
    both 30 already. \r\n\r\nIt has been a pleasure knowing you for so long! My travel
    partner and the closest friend I ever had. You have been here for the good and
    bad times and I hope these bad ones will be over soon. \r\n\r\nI miss our travels
    and I hope we can go to that Machu Picchu trip soon! \r\n\r\nAnyways remember
    to stay true to yourself and your dreams! Life\u2019s too short not to pursue
    your dreams!!\r\n\r\nAll the best, \r\n\r\nJamie"
  noteImage: {fileID: 0}
  noteImageWidth: 0
  noteImageHeight: 0
  onFinishedReading:
    m_PersistentCalls:
      m_Calls: []
