  m_Script: {fileID: 11500000, guid: 0b884e95bf60f257ba8b624d98dd0bb2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteItem
  noteTitle: Broken Picture
  noteBody: "There seems to be two people in the photograph.\r\n\r\nThey seem happy
    to be going on a hiking trip somewhere in the Alps. They look happy and are hugging
    each other. \r\n\r\nThe person on the right seems familiar but you can\u2019t
    put a finger on it.\r\n\r\nOn the left, there is another person. That is you.
    \r\n\r\nSo you must know who the person is. You seem close. You must remember."
  noteImage: {fileID: 0}
  noteImageWidth: 0
  noteImageHeight: 0
  onFinishedReading:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 11044119}
